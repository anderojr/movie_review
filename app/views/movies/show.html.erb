<section class="section">
  <%= render @movie %>

  <div class="buttons mt-5">
    <%= link_to 'Edit', edit_movie_path(@movie), class: "button is-info" %>
    <%= link_to 'Delete', @movie, class: "button is-danger", data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this movie?' } %>
    <%= link_to 'Back to movies', movies_path, class: "button" %>
  </div>
</section>
